# 将此文件复制为 .env 后按部署环境修改；不要提交包含密码或 API Key 的真实 .env。
APP_NAME=Enterprise RAG Assistant
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# Docker Compose 使用的 PostgreSQL 开发配置，不可作为生产凭据。
POSTGRES_DB=enterprise_rag
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://rag_user:rag_password@localhost:5432/enterprise_rag

# 文档摄取限制；Markdown 和纯文本必须使用 UTF-8。
MAX_DOCUMENT_SIZE_BYTES=10485760
MAX_DOCX_UNCOMPRESSED_SIZE_BYTES=52428800

# 扫描版 PDF OCR 默认不安装；启用后需要重新构建 API 镜像。
INSTALL_OCR=false
OCR_LANGUAGE=ch
OCR_MIN_CONFIDENCE=0.85
OCR_PDF_RENDER_SCALE=2.0

# 本地向量模型与 dense 检索配置。
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
# 可选本地模型快照路径；逻辑模型名称仍用于索引溯源。
# EMBEDDING_MODEL_PATH=.model_cache/models/AI-ModelScope--bge-small-zh-v1.5/snapshots/master
EMBEDDING_DIMENSION=512
EMBEDDING_BATCH_SIZE=32
EMBEDDING_QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：
DENSE_SEARCH_MAX_TOP_K=20

# 阿里云百炼回答模型；真实密钥只能放在本地 .env 或进程环境中。
ANSWER_PROVIDER=bailian
ANSWER_MODEL_NAME=qwen-plus
ANSWER_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
ANSWER_TEMPERATURE=0
# 制度回答是基于证据的结构化任务，默认关闭高成本深度思考。
ANSWER_ENABLE_THINKING=false
ANSWER_TIMEOUT_SECONDS=60
ANSWER_MAX_RETRIES=2
# 评测或部署者填写每百万 token 价格；留空/0 时只记录 token，不猜测账单。
ANSWER_INPUT_COST_PER_MILLION_USD=0
ANSWER_OUTPUT_COST_PER_MILLION_USD=0
ANSWER_PROMPT_VERSION=v1
# Function Calling 路由默认使用本地规则；启用百炼时改为 bailian。
TOOL_ROUTING_PROVIDER=rule
TOOL_ROUTING_MODEL_NAME=qwen-plus
TOOL_ROUTING_TEMPERATURE=0
TOOL_ROUTING_TIMEOUT_SECONDS=30
TOOL_ROUTING_MAX_RETRIES=2

# 生产环境必须将 JWT 密钥替换为随机长密钥。
JWT_SECRET=development-only-change-this-jwt-secret
JWT_ISSUER=enterprise-rag-assistant
JWT_EXPIRE_MINUTES=60
