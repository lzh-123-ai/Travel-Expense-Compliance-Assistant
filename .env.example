# Copy this file to .env when Stage 1 asks you to configure the application.
# Never commit the real .env file because it may contain passwords and API keys.
APP_NAME=Enterprise RAG Assistant
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# Local PostgreSQL settings used by Docker Compose.
# These values are development defaults, not production credentials.
POSTGRES_DB=enterprise_rag
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://rag_user:rag_password@localhost:5432/enterprise_rag

# Document ingestion limits. Markdown and text documents must use UTF-8.
MAX_DOCUMENT_SIZE_BYTES=10485760
MAX_DOCX_UNCOMPRESSED_SIZE_BYTES=52428800
